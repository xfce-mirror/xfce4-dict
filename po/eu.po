#: lib/prefs.c:640
msgid "Spell Check Program:"
msgstr "Ortografia-zuzentzailea:"

#: lib/prefs.c:657
msgid ""
"<i>The spell check program can be 'enchant-2', 'aspell', 'ispell' or any other spell check program which is compatible to the ispell command.\n"
"The icon shows whether the entered command exists.</i>"
msgstr "<i>Ortografia-zuzentzailea 'enchant-2', 'aspell', 'ispell' edo ispell komandoarekin bateragarria den beste edozein programa izan daiteke.\nIkonoak adierazten du idatzitako komandoa existitzen den ala ez.</i>"

#: lib/prefs.c:734
#, c-format
msgid ""
"This works with Ollama or any service that implements its HTTP API.\n"
"HTTPS is not supported.\n"
"Services like ChatGPT or Gemini are not supported, and there are no plans to add support.\n"
"The prompt must include a %s placeholder where the search term will be inserted."
msgstr "Ollama-rekin edo haren HTTP APIa inplementatzen duen edozein zerbitzurekin funtzionatzen du.\nHTTPS ez da onartzen.\nChatGPT edo Gemini bezalako zerbitzuak ez dira onartzen, eta ez dago euskarria gehitzeko asmorik.\nGonbitak %s leku-marka bat izan behar du, bilaketa-terminoa non txertatuko den adierazteko."

